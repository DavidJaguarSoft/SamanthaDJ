<UserControl x:Class="SamanthaDJ.ServiceWPF.UserControl.HomeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SamanthaDJ.ServiceWPF.UserControl"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1300" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <!--Header-->
            <RowDefinition Height="64"/>
            <!--Log-->
            <RowDefinition Height="*"/>
            <!--Footer-->
            <RowDefinition Height="70"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <!--Grid Header-->
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>

            <!--1 Column data-->
            <TextBlock Grid.Column="1" Grid.Row="1" Text="User:" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <TextBlock Name="textBlockUser" Grid.Column="3" Grid.Row="1" Text="MyUserName@MyDomain.com"
                       Grid.ColumnSpan="3" Foreground="Blue"
                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Grid.Row="2" Text="Grammar mode:" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <TextBlock Name="TextBlockGrammarMode" Grid.Column="3" Grid.Row="2" Text="-Grammar mode-" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!--2 Column data-->
            <TextBlock Grid.Column="5" Grid.Row="1" Text="Culture:" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <TextBlock Name="lblCulture" Grid.Column="7" Grid.Row="1" Text="CultureData" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" />

            <TextBlock Grid.Column="5" Grid.Row="2" Text="UICulture:" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Name="lblUICulture" Grid.Column="7" Grid.Row="2" Text="UICultureData" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="5" Grid.Row="3" Text="Culture Speech:" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Name="lblCultureSpeech" Grid.Column="7" Grid.Row="3" Text="CultureSpeechData" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!--3 Column data-->
            <Button Name="ButtonReconect" Grid.Column="9" Grid.Row="1" Content="Reconnect microphone" Background="Red" Foreground="White" FontSize="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="ButtonReconect_Click" Width="139"/>

            <ProgressBar Name="progressBarListening" Grid.Column="11" Grid.Row="1" Value="0" Height="11" Width="100" Background="DarkGray" Foreground="Red"
                     HorizontalAlignment="Left"/>
            <TextBlock Name="textBlockProgressBar" Text="{Binding ElementName=progressBarListening, Path=Value, StringFormat={}{0:0}}"
                   Grid.Column="11" Grid.Row="1" FontSize="8" Foreground="White"
                   HorizontalAlignment="Left" TextAlignment="Center" VerticalAlignment="Center" Width="27" Margin="37,0,0,0" />

            <TextBlock Grid.Column="9" Grid.Row="2" Text="Ticks Samantha Listens:" FontSize="12" HorizontalAlignment="Right"/>
            <TextBlock Name="textBlockTickListen" Grid.Column="11" Grid.Row="2" Text="Ticks" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="9" Grid.Row="3" Text="Speech detected:" FontSize="12" HorizontalAlignment="Right"/>
            <!--<TextBlock Name="lblLoud" Grid.Column="11" Grid.Row="3" Text="Ruido" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>-->
            <ProgressBar Name="progressBarSpeechDetected" Grid.Column="11" Grid.Row="3" Value="0" Height="11" Width="10"
                         Background="White" Foreground="Red" Minimum="0" Maximum="100"
                         HorizontalAlignment="Left"/>

            <!--Version-->
            <!--<TextBlock Grid.Column="7" Grid.Row="3" Text="Version:" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="96,0,0,0" Width="96"/>
        <TextBlock Name="textVersion" Grid.Column="9" Grid.Row="3" Text="" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>-->

        </Grid>

        <!--Grid Details-->
        <Grid Grid.Column="1" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <!--Log area-->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5"/>
                <!--Button area-->
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>

            <!--Log area-->
            <RichTextBox Name="RichTextLog" Grid.Column="1" Grid.Row="1" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto">
                <FlowDocument>
                    <!--<Paragraph Name="paragraphLog">
                    -->
                    <!--<Run FontWeight="Bold">Texto en Negrita</Run>
                    <Run FontStyle="Italic">y Texto en Cursiva.</Run>-->
                    <!--
                </Paragraph>-->
                </FlowDocument>
            </RichTextBox>

            <!--Button area-->
            <Grid Grid.Column="3" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <Button Name="ButtonLogClear" Grid.Column="1" Grid.Row="1" Content="Clear log" Background="Blue"
                    Foreground="White" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"
                    ToolTip="Clean Log information"
                    Click="ButtonLogClear_Click" Height="30"/>

                <Button Name="ButtonViewLogFiles" Grid.Column="1" Grid.Row="3" Content="View Log Files" Background="DarkBlue"
                    Foreground="White" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"
                    ToolTip="View log files in the file explorer"
                    Click="ButtonViewLogFiles_Click" Height="30"/>

                <Button Name="ButtonConfiguration" Grid.Column="1" Grid.Row="5" Content="Configuration" Background="Orange"
                    Foreground="Black" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"
                    ToolTip="Parameters configuration"
                    Click="ButtonConfiguration_Click" Height="30"/>

                <Slider Name="SliderOnlyOneAndSamantha" Minimum="0" Maximum="1" Value="0" TickPlacement="BottomRight" TickFrequency="1" Grid.Column="1" Grid.Row="9"
                        IsSnapToTickEnabled="True" FontSize="30" Ticks="0,1" ToolTip="Just me and Samantha Talking"
                        Height="20" Width="25" IsSelectionRangeEnabled="False" SelectionEnd="1" ValueChanged="SliderOnlyOneAndSamantha_ValueChanged">
                    <Slider.RenderTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </Slider.RenderTransform>
                    <Slider.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Red" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="Yellow" />
                    </Slider.Resources>
                </Slider>

                <TextBlock Name="TextBlockSamanthaListening" Grid.Column="1" Grid.Row="11" Text="Samantha is Listening"
                           TextAlignment="Center" Foreground="red" FontWeight="Bold"
                           FontSize="12" HorizontalAlignment="Center" Width="140" Margin="0,15,0,0"/>

                <Button Name="ButtonRestartService" Grid.Column="1" Grid.Row="23" Content="Restart Service" Background="Black"
                    Foreground="White" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"
                    ToolTip="Reload the initial information from the JSon file and the Data Base information"
                    Click="ButtonRestartService_Click" Height="30"/>

            </Grid>
        </Grid>

        <!--<Button Padding="10 5"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Command="{Binding NotifyCommand}"
        Content="Notify" />-->

        <!--Grid Foot-->
        <Grid Grid.Column="1" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="1" Grid.Row="1">
            <Hyperlink RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://www.DavidJaguarSoft.com">
                Administrar mi cuenta de Samantha DJ
            </Hyperlink>
            </TextBlock>

            <TextBlock Name="textVersion" Text="Version: x" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Name="textAllRightsReserved" Text="All Rights Reseved..." Grid.Row="3" Grid.Column="1"/>

            <Grid Grid.Row="1" Grid.Column="3" Grid.RowSpan="3">
                <Button Name="ButtonClose" Content="Close" Background="Red" Height="30" Margin="5,0,5,0"
                Foreground="White" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"
                Click="ButtonClose_Click"/>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
