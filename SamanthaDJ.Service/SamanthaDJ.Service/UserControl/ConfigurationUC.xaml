<UserControl x:Class="SamanthaDJ.Service.UserControl.ConfigurationUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SamanthaDJ.Service.UserControl"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1300">
    <Grid Background="WhiteSmoke">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <!--Header-->
            <RowDefinition Height="50"/>
            <!--Content-->
            <RowDefinition Height="*"/>
            <!--Footer-->
            <RowDefinition Height="70"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <TextBlock Name="textBlockUser" Grid.Column="1" Grid.Row="1" Text="Parameter Configuration" Foreground="Blue"
            FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="38,0,0,0" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Grid.Column="1" Grid.Row="2">
            <Grid ScrollViewer.HorizontalScrollBarVisibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <!--CREDENTIALS-->
                <TextBlock Grid.Column="1" Grid.Row="1" Text="Credentials"
                    FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Grid.Row="3" Text="User name"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Name="TBUserName" Grid.Column="3" Grid.Row="3"/>

                <TextBlock Grid.Column="1" Grid.Row="5" Text="Token"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Name="TBToken" Grid.Column="3" Grid.Row="5" Grid.RowSpan="5" MaxLines="5"/>

                <!--BEHAVIOR-->
                <TextBlock Grid.Column="7" Grid.Row="1" Text="Behavior"
                    FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="7" Grid.Row="3" Text="Grammar Load Mode"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ComboBox Name="CBGrammarLoadMode" Grid.Column="9" Grid.Row="3" VerticalAlignment="Center">
                    <ComboBoxItem Tag="INSTRUCTIONONLY" Content="Instruction Only" IsSelected="True"/>
                </ComboBox>

            </Grid>
        </ScrollViewer>

        <Button Name="ButtonClose" Grid.Column="1" Grid.Row="3" Content="Close" Background="Purple" Height="30" 
            Foreground="White" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" Width="70"
            HorizontalAlignment="Right" Click="ButtonClose_Click"/>

    </Grid>
</UserControl>
