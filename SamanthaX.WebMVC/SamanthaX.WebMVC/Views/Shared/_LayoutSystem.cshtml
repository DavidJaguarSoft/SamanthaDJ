<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("Samantha Executive v20260317.01", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Catalogs
                        </a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Word Class", "CatalogWC", "WordClass", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                            <li>@Html.ActionLink("Recognized Words", "CatalogRW", "RecognizedWord", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Dashboards
                        </a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Grammar", "DashboardG", "Grammar", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                            <li>@Html.ActionLink("Recognized Instructions", "DashboardRI", "RecognizedInstruction", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                            </svg>
                        </a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("My Profile", "MyProfile", "System", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                            <li><hr class="dropdown-divider"></li>
                            <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                            <li>@Html.ActionLink("Technical Support", "TechnicalSupport", "System", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                            <li>@Html.ActionLink("Ters and Conditions", "TermsAndConditionsEN", "Home", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                            <li>@Html.ActionLink("Privacy Notice", "PrivacyNoticeEN", "Home", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                            <li><hr class="dropdown-divider"></li>
                            <li>@Html.ActionLink("Logout", "Logout", "System", new { area = "" }, new { @class = "dropdown-item nav-link ms-2", @style = "color:black" })</li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; 2013 David Jaguar Soft</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    
    @RenderSection("scripts", required: false)
</body>
</html>

