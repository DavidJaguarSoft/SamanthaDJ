@{
    ViewBag.Title = "UserAlreadyRegistered";
}
<main aria-labelledby="title">
    <div class="container mt-5">
        <div class="card mb-3 border-0">
            <div class="row g-0">
                <div class="col-md-5">
                    <img src="~/Utils/Images/img05.png" class="img-fluid rounded-start" alt="...">
                </div>
                <div class="col-md-7">
                    <div class="card-body">
                        <h3 class="card-title">Este Correo ya se había Registrado</h3>
                        <p class="card-text">Esta cuenta de correo, @Session["UserRegisteredEMail"], comenzó su registo el @Session["UserRegisteredDate"], pero no se concluyó. </p>
                        <p class="card-text">Si desea concluir su registro oprima el botón y complete los formularios.</p>
                        <div class="text-center">
                            <a href="~/Home/CompleteYourRegistration" class="btn btn-success">Completar Registro</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>