@{
    ViewBag.Title = "I forgot my password";
}
<main aria-labelledby="title">
    
    <div class="row">

        <div class="danger">
            @ViewBag.Error
        </div>

        <div class="col-md-4"></div>

        <div class="col-md-4">
            <h2 id="title">@ViewBag.Title.</h2>

            @using(Html.BeginForm("")) {
                <form action="@Url.Content("~/Home/ForgotPassword")" method="post">
                    <div class="form-group">
                        <label>Email</label>
                        <br />
                        @Html.TextBox(
                            "EMail",
                            null,
                            new {
                                @class = "form-control",
                                @placeholder = "Your EMail"
                            })
                        <div style="color:red;">@Html.ValidationMessage("EMail")</div>
                        <br />
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary">Enviar Contraseña a mi Correo</button>
                    </div>

                    @if(ViewData["ErrorMessageSX"] != null) {
                        <div class="mt-2">
                            <div class="alert alert-warning" role="alert">
                                @ViewData["ErrorMessageSX"]
                            </div>
                        </div>
                    }

                </form>
            }
        </div>

        <div class="col-md-4"></div>
    </div>

</main>

